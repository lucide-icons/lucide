# Local testing for the suggest-metadata action.
# Copy to `.env` in this folder and run `pnpm suggest:metadata:debug`.
# In debug mode the review is printed instead of posted to GitHub.

# Required
OPENAI_API_KEY=
# A GitHub token with read access to pull requests (e.g. a fine-grained PAT)
GITHUB_TOKEN=
# The pull request to generate suggestions for
PULL_REQUEST_NUMBER=

# Optional
# OpenAI model to use (default: gpt-5-mini)
# OPENAI_API_MODEL=gpt-5-mini
# Commit the review comments are anchored to (default: the pull request's head commit)
# COMMIT_SHA=
# Reviewer login used to skip PRs that were already reviewed (default: github-actions[bot])
# REVIEWER=
# Read icon JSON from the local checkout instead of the PR on GitHub (default: false)
# USE_FILE_SYSTEM=true
