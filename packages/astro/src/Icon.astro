---
import buildLucideIconNode from './utils/buildLucideIconNode';
import type { IconProps as Props } from './types';
import { hasA11yProp } from './utils/hasA11yProp';

const {
  color = 'currentColor',
  size = 24,
  width,
  height,
  'stroke-width': strokeWidth = 2,
  absoluteStrokeWidth = false,
  nonScalingStroke = false,
  iconNode = [],
  icon = {
    node: iconNode,
    aliases: [],
    size: 24,
  },
  class: className,
  ...rest
} = Astro.props;

const defaultSlot = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const hasDefaultSlot = defaultSlot.trim().length > 0;

const [, builtIconAttributes, builtIconNode = []] = buildLucideIconNode(icon, {
  color,
  width: width ?? size,
  height: height ?? size,
  strokeWidth,
  absoluteStrokeWidth,
  nonScalingStroke,
  ...(className !== undefined && { className }),
  hasA11yProp: hasDefaultSlot || hasA11yProp(rest),
});

const iconAttributes = {
  ...builtIconAttributes,
  ...rest,
};
---

<svg {...iconAttributes}>
  {builtIconNode.map(([Tag, attrs]) => <Tag {...attrs} />)}
  {hasDefaultSlot && <Fragment set:html={defaultSlot} />}
</svg>
