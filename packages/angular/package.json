{
  "name": "@lucide/angular",
  "description": "A Lucide icon library package for Angular applications.",
  "version": "0.0.1",
  "author": "karsa-mistmere",
  "license": "ISC",
  "homepage": "https://lucide.dev",
  "bugs": "https://github.com/lucide-icons/lucide/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucide-icons/lucide.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "directory": "dist"
  },
  "scripts": {
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "prebuild": "pnpm clean && pnpm copy:license && pnpm copy:utils && pnpm build:icons",
    "build": "pnpm prebuild && pnpm build:ng",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "copy:utils": "cpy ../../packages/shared/src/build/{buildLucideIconNode.ts,defaultAttributes.ts,types.ts} ../../packages/shared/src/utils/mergeClasses.ts ./src/utils/",
    "clean": "rm -rf dist && rm -rf ./src/icons/*.ts",
    "build:icons": "build-icons --output=./src --templateSrc=./scripts/exportTemplate.mts --renderUniqueKey --iconFileExtension=.ts --exportFileName=lucide-angular.ts --useDefaultExports=0",
    "build:ng": "ng build --configuration production",
    "test": "pnpm copy:utils && pnpm build:icons && ng test --no-watch",
    "test:watch": "pnpm copy:utils && ng test",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx,html,css,scss}' --quiet --fix",
    "e2e": "ng e2e"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "devDependencies": {
    "@angular-eslint/builder": "~22.2.0",
    "@angular-eslint/schematics": "~22.2.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@lucide/build-icons": "workspace:*",
    "@lucide/helpers": "workspace:*",
    "@vitest/browser-playwright": "^4.1.10",
    "angular-eslint": "22.2.0",
    "ng-packagr": "^22.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0"
  }
}
