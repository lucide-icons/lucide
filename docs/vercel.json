{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "cleanUrls": true,
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/icon/:path*",
      "destination": "/icons/:path*",
      "permanent": true
    },
    {
      "source": "/docs/:slug(lucide-?.*)",
      "destination": "/guide/:slug",
      "permanent": true
    },
    {
      "source": "/docs/:slug(.*-?guide)",
      "destination": "/guide/design/:slug",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "/guide/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "search"
        }
      ],
      "destination": "/icons",
      "permanent": false
    },
    {
      "source": "/guide/basics",
      "destination": "/guide/react/basics",
      "permanent": true
    },
    {
      "source": "/guide/advanced/accessibility",
      "destination": "/guide/accessibility",
      "permanent": true
    },
    {
      "source": "/guide/advanced",
      "destination": "/guide/react/advanced",
      "permanent": true
    },
    {
      "source": "/guide/packages/lucide",
      "destination": "/guide/lucide",
      "permanent": true
    },
    {
      "source": "/guide/packages/lucide-:package",
      "destination": "/guide/:package",
      "permanent": true
    },
    {
      "source": "/guide/packages/:package",
      "destination": "/guide/:package",
      "permanent": true
    },
    {
      "source": "/contributing",
      "destination": "/contribute",
      "permanent": true
    },
    {
      "source": "/contribute/icon-design-guide",
      "destination": "/contribute/icons/design-principles",
      "permanent": true
    },
    {
      "source": "/contribute/illustrator-guide",
      "destination": "/contribute/icons/illustrator-guide",
      "permanent": true
    },
    {
      "source": "/contribute/inkscape-guide",
      "destination": "/contribute/icons/inkscape-guide",
      "permanent": true
    },
    {
      "source": "/contribute/figma-guide",
      "destination": "/contribute/icons/figma-guide",
      "permanent": true
    },
    {
      "source": "/contribute/affinity-designer-guide",
      "destination": "/contribute/icons/affinity-designer-guide",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "cache-control: public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
