# Copy to `docs/.env`.

# Icon popularity from Plausible. Defaults to 0 for every icon when unset.
LUCIDE_ANALYTICS_TOKEN=

# Set to `true` to also show icons that are not released yet.
VITE_SHOW_AWAITING_RELEASE=

# Client-side Algolia icon search (public search-only key). Required for the icon search.
# The index is filled by the Algolia crawler.
VITE_ALGOLIA_APP_ID=R7KKMCPXOB
VITE_ALGOLIA_SEARCH_API_KEY=dd3101054267d35fb28f49c42715f1aa
VITE_ALGOLIA_INDEX_NAME=icons
