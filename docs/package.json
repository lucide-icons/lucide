    "@types/semver": "^7.8.0",
    "h3": "^1.15.11",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "nitropack": "^2.13.4",
    "rollup-plugin-copy": "^3.5.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.3",
    "shiki": "^4.4.1",
    "simple-git": "^3.36.0",
    "sitemap": "^9.0.1",
    "svg-path-commander": "^2.2.1",
    "svg-pathdata": "^9.0.0",
    "svgson": "^5.3.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-llms": "^1.13.4"
  },
  "dependencies": {
