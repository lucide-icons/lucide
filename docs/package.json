    "fuse.js": "^7.5.0",
    "jszip": "^3.10.1",
    "lodash-es": "^4.18.1",
    "lucide": "workspace:*",
    "lucide-react": "workspace:*",
    "motion-v": "2.3.0",
    "react": "19.2.8",
