{
  "language": "en,en-GB",
  "dictionaries": ["en-us", "custom-words"],
  "dictionaryDefinitions": [
    {
      "name": "custom-words",
      "path": "./.cspell/custom-words.txt",
      "addWords": true
    }
  ],
  "ignoreRegExpList": [
    "/\"contributors\"\\s*:\\s*\\[[^\\]]*\\]/g",
    "/\"name\"\\s*:\\s*\"[^\"]*\",\\s*\"deprecated\"\\s*:\\s*true,\\s*\"deprecationReason\"\\s*:\\s*\"alias\\.typo\"/g"
  ]
}
