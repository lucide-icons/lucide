{
  "name": "@lucide/integration-svelte-sveltekit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "vitest run",
    "check": "pnpm build && pnpm typecheck && pnpm test:browser"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@lucide/svelte": "workspace:*",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.58.2",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.3",
    "vitest-browser-svelte": "3.1.0"
  }
}
