{
  "name": "@lucide/integration-svelte-sveltekit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "vitest run",
    "check": "pnpm build && pnpm typecheck && pnpm test:browser"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@lucide/svelte": "workspace:*",
    "svelte": "5.58.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  }
}
